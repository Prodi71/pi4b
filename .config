# ============================================================
# Seed .config для сборки OpenWrt под Raspberry Pi 4 B (bcm27xx/bcm2711)
#
# Это НЕ полный .config — это "seed"-файл. Сборочная система сама
# дополнит его значениями по умолчанию для всех незаданных опций
# командой `make defconfig` (см. workflow build-openwrt.yml).
#
# Если нужна другая модель (например, Pi 400 или CM4) — поменяйте
# блок "Target System" ниже.
# ============================================================

# --- Target System: Broadcom BCM27xx, подсемейство BCM2711 (Pi 4) ---
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2711=y
CONFIG_TARGET_bcm27xx_bcm2711_DEVICE_rpi-4=y

# --- Пакеты (взято из вашего packages_config_obrez.txt) ---
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_base-files=y
